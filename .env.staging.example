# Staging Environment Configuration
# Copy to .env.staging and fill in values

VITE_SUPABASE_URL=your-staging-supabase-url
VITE_SUPABASE_ANON_KEY=your-staging-supabase-anon-key

# Sentry (staging project)
VITE_SENTRY_DSN=your-staging-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-org
SENTRY_PROJECT=frelux-staging

# Analytics
VITE_GA_MEASUREMENT_ID=your-staging-ga-id

# Ad network (test ad units)
VITE_ADSENSE_CLIENT=ca-pub-test
VITE_ADSENSE_SLOT_BANNER=test-slot
VITE_ADSENSE_SLOT_SIDEBAR=test-slot

# Feature flags
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_PRO_CONNECT=true
VITE_ENABLE_ADS=true
