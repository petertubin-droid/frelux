VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SITE_URL=https://freluxtools.netlify.app
VITE_OPENWEATHER_API_KEY=
VITE_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY is server-only (set as a Supabase Edge Function secret, NOT in .env)

# Paystack (Nigerian payment provider)
VITE_PAYSTACK_PUBLIC_KEY=

# Sentry (error monitoring — free tier: 5K events/month)
# Get your DSN at https://sentry.io → Project Settings → Client Keys
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# Source map upload (for readable stack traces in production)
# Find these at: Sentry → Settings → Auth Tokens, and Project Settings
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Get your DSN at https://sentry.io → Project Settings → Client Keys
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
