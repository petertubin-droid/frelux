VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SITE_URL=https://freluxtools.com
VITE_OPENWEATHER_API_KEY=
VITE_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY is server-only (set as a Supabase Edge Function secret, NOT in .env)

# Paystack hosted checkout is initialized server-side; configure PAYSTACK_SECRET_KEY
# as a Supabase Edge Function secret. No browser public key is used.
# Legacy only, not required by the hosted checkout flow:
VITE_PAYSTACK_PUBLIC_KEY=

# Sentry (error monitoring — free tier: 5K events/month)
# Get your DSN at https://sentry.io → Project Settings → Client Keys
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# Source map upload (for readable stack traces in production)
# Find these at: Sentry → Settings → Auth Tokens, and Project Settings
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Get your DSN at https://sentry.io → Project Settings → Client Keys
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# CARTO basemap key (client-facing: it ships in the bundle).
VITE_CARTO_API_KEY=

# Cloudflare R2 file storage (docs/cloudflare-r2-workers.md).
# Leave both empty to keep uploads on Supabase Storage.
VITE_R2_WORKER_URL=
VITE_STORAGE_DRIVER=

# Cloudflare Turnstile (bot protection on public forms).
# The site key is public and is baked into the build; the secret is never
# shipped to the browser. Frontend builds read VITE_CLOUDFLARE_TURNSTILE_SITE_KEY;
# the turnstile-verify edge function reads TURNSTILE_SECRET and
# TURNSTILE_HOSTNAMES from the Supabase function environment.
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
